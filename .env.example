PORT=3000
HOST=0.0.0.0
# Required for a public deployment. Do not expose this value to browser code.
SIGNAL402_API_KEY=replace-with-a-long-random-value
# Set by the AWS template; omit locally to use in-memory storage.
DYNAMODB_TABLE=
AWS_REGION=us-east-1
# Required before HTTPS resources can be paid. The default demo facilitator only
# validates demo:// requests and fails closed for real endpoints.
X402_FACILITATOR_URL=
X402_FACILITATOR_API_KEY=
